tasks = []

print("=== ТРЕКЕР ЗАДАЧ ===")

while True:
    print("\n1. Добавить задачу")
    print("2. Показать все задачи")
    print("3. Удалить задачу")
    print("4. Выход")
    
    choice = input("Выберите действие (1-4): ")
    
    if choice == "1":
        new_task = input("Введите текст задачи: ")
        tasks.append(new_task)
        print(" Задача добавлена!")
        
    elif choice == "2":
        if len(tasks) == 0:
            print("📭 Список задач пока пуст.")
        else:
            print("\nВаши задачи:")
            for i in range(len(tasks)):
                print(i + 1, ".", tasks[i])
                
    elif choice == "3":
        if len(tasks) == 0:
            print("Удалять нечего, список пуст.")
        else:
            num = int(input("Введите номер задачи для удаления: "))
            if 1 <= num <= len(tasks):
                removed = tasks.pop(num - 1)
                print("Задача удалена:", removed)
            else:
                print(" Неверный номер задачи!")
                
    elif choice == "4":
        print("До встречи,продуктивного дня!")
        break
    else:
        print("Не понял вас, введите цифру от 1 до 4.")
